# Auto-Generate scoring backend (all optional; the settings UI writes the
# same values to llm_config.json in the data dir, and env vars win).
#
# Backend selection: local | api | g4f (dev-only, must be installed manually).
# Leave unset to auto-resolve: local server if one responds, else api if a
# key is configured, else Auto-Generate is disabled.
#HI_LITE_LLM_BACKEND=

# OpenAI-compatible API backend: your provider, your account, your terms.
#HI_LITE_LLM_BASE_URL=https://api.openai.com/v1
#HI_LITE_LLM_API_KEY=
#HI_LITE_LLM_MODEL=gpt-4o-mini

# Local model backend (Ollama / llama.cpp-compatible server).
#HI_LITE_LLM_LOCAL_URL=http://127.0.0.1:11434
#HI_LITE_LLM_LOCAL_MODEL=qwen2.5:7b-instruct

# Note: this .env is only read by the Auto-Generate scorer. All other
# configuration is plain environment variables (WHISPER_MODEL, HI_LITE_PORT,
# HI_LITE_DATA_DIR, HI_LITE_PRE_BUFFER, HI_LITE_POST_BUFFER, FFMPEG_PATH,
# FFPROBE_PATH) -- see README.
