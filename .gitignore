# Python
__pycache__/
*.py[cod]
*.so

# Environment files (secrets)
.env
.env.backup
# Auto-Generate settings (holds the user's LLM API key; in dev the data dir
# is the repo root, so this file lands here)
llm_config.json

# Generated data (pipeline outputs, uploads, models)
highlights/
whisper_models/
uploads/*
!uploads/.gitkeep

# Media files (large; never commit source/test videos)
*.mp4
*.wav

# Node
node_modules/
dist/

# Logs / pids
*.log
*.pid
*.seed
*.pid.lock

# IDE / local tooling
.vscode/
.idea/
.claude/settings.local.json

# OS generated
.DS_Store
Thumbs.db

# PyInstaller build output (generated by build-windows.sh / pyinstaller)
/build/

# Local data dir (HI_LITE_DATA_DIR pointed here in dev; models etc.)
/.data/
